{
  "name": "harbour-tycoon",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "balance": "tsx scripts/balance-report.ts",
    "build:web": "expo export --platform web --output-dir dist",
    "models:export": "tsx scripts/export-models.ts",
    "publish:web": "node scripts/publish-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-tracking-transparency": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
